# Pilldoor Website - Environment Configuration Template
# Duplicate this file as .env.local for local development

# Base URL of the website
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstream CRM / Operations Desk API integration (for demo requests & enquiries)
OS_EZORO_API_URL=https://api.ezoro.in
EXTERNAL_API_KEY=your_upstream_api_key_here

# PharmaOps Backend API integration (for completed OTC website orders)
PHARMA_BACKEND_URL=https://pharma.ezoro.in
WEBSITE_ORDER_API_KEY=your_website_order_api_key_here

